{
  "name": "dachuanpro-desktop",
  "version": "1.2.0",
  "private": true,
  "description": "大川Pro CRM/ERP Windows 桌面工作台",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:only",
    "test:only": "node --test --experimental-strip-types --no-warnings \"test/*.test.mjs\"",
    "lint": "node scripts/lint.mjs",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:main",
    "package": "npm run build && npm run dist:dir",
    "package:installer": "npm run build && npm run dist",
    "dist:dir": "electron-builder --dir",
    "dist": "electron-builder",
    "icon": "node scripts/gen-icon.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
